{
  "name": "@joshghent/website",
  "version": "5.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf _site",
    "serve:eleventy": "ELEVENTY_ENV=development eleventy --serve",
    "serve": "npm-run-all clean --parallel serve:*",
    "build:eleventy": "ELEVENTY_ENV=production eleventy",
    "build": "NODE_ENV=production run-s clean 'build:*'",
    "serve:css": "npx postcss ./src/styles/main.css --o _site/style.css --watch",
    "spellcheck": "mdspell -a -n -r 'src/blog/**/*.md'",
    "spellcheck:correct": "mdspell -a -n 'src/blog/**/*.md'",
    "validate:templates": "node scripts/validate_templates.mjs",
    "check:accessibility": "node scripts/check_accessibility.mjs"
  },
  "keywords": [],
  "author": "Josh Ghent",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.24",
    "cssnano": "^7.1.2",
    "markdown-spellcheck": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "pa11y": "^10.0.0",
    "postcss": "~8.5.23",
    "postcss-cli": "^11.0.1",
    "puppeteer": "^25.9.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "~5.0.12",
      "markdown-it": "~15.0.1",
      "js-yaml": "~4.3.2",
      "svgo": "~4.1.0",
      "baseline-browser-mapping": "~2.11.0",
      "nanoid": "~5.1.11",
      "browserslist": "~4.28.7",
      "postcss-selector-parser": "~7.1.3",
      "linkify-it": "~5.0.2",
      "shell-quote": "~1.9.0",
      "ws": "~8.21.0",
      "liquidjs": "~10.26.0",
      "tmp": "~0.2.6",
      "lodash": "~4.18.0",
      "picomatch": "~2.3.2"
    }
  }
}
